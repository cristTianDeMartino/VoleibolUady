# Copia este archivo a .env y rellena los valores reales. Nunca commitees .env.

# Prisma no carga .env automáticamente — ver prisma.config.ts.
DATABASE_URL="file:./dev.db"

# Secreto usado para firmar (HMAC) la cookie de sesión (lib/session.ts).
# OBLIGATORIO en producción — genera uno con: openssl rand -hex 32
SESSION_SECRET=""
