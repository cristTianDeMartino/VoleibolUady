generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}


enum Posicion {
  ACOMODO
  CENTRAL
  BANDA
  LIBERO
  OPUESTO
}

enum EstadoAtleta {
  ACTIVO
  EGRESADO
}

model Atleta {
  id               String       @id @default(cuid())
  nombre           String
  apellidos        String
  matricula        String?      // solo atletas (JUGADOR); los ADMIN no tienen matrícula
  fechaNacimiento  DateTime?    // pública — visible para compañeros de equipo
  licenciatura     String?      // pública — visible para compañeros de equipo
  genero           String       @default("F")
  rama             String       @default("Femenil") // derivado de genero — no exponer en formularios; ver lib/constants/genero.ts
  posicion         Posicion?
  facultad         String
  directorFacultad String
  semestre         Int
  telefonoPersonal String
  telefonoTutor    String
  correo           String?
  rolTecnico       String?
  codigoAcceso     String       @unique
  rol              String       @default("JUGADOR")
  estado           EstadoAtleta @default(ACTIVO)
  fotoUrl          String?

  // Roster — visibles para todo el equipo
  anioIngreso      Int
  anioEgreso       Int?      // gestionado solo por egresarAtleta/reactivarAtleta, nunca editable en UI
  numUniforme      Int?
  tallaPlayera     String?   // XS | S | M | L | XL | XXL
  tallaShort       String?
  tallaPants       String?
  tallaChamarra    String?

  privado          AtletaPrivado?
  claveAtleta      ClaveAtleta?
  lesiones         Lesion[]
  asistencias      Asistencia[]
  citas            CitaMedica[]
  createdAt        DateTime     @default(now())
}

// Respaldo en texto plano de la clave de acceso generada — única fuente
// recuperable. codigoAcceso en Atleta siempre guarda el hash (bcrypt).
model ClaveAtleta {
  id         String   @id @default(cuid())
  atletaId   String   @unique
  atleta     Atleta   @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  clavePlana String   @unique
  creadaEn   DateTime @default(now())
}

model AtletaPrivado {
  id                String  @id @default(cuid())
  atletaId          String  @unique
  atleta            Atleta  @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  nss               String?
  curp              String? // privado — solo admin y propio atleta

  seguroAseguradora String?
  seguroPoliza      String?
  seguroTitular     String?
}

model Partido {
  id             String   @id @default(cuid())
  rama           String   // "Varonil" o "Femenil"
  torneo         String   // Nombre del torneo o liga
  fecha          DateTime // Fecha del partido
  hora           String   // Hora del partido (ej. "18:00")
  sede           String   // Lugar donde se jugó
  rival          String   // Nombre del equipo contrario
  numeroSets     Int      // Cantidad de sets jugados (ej. 3, 4, 5)
  resultadoSets  String   // Parciales del partido (ej. "25-23, 22-25, 15-11")
  resultadoFinal String   // "Ganado" o "Perdido"
  createdAt      DateTime @default(now())
}

model Asistencia {
  id        String   @id @default(cuid())
  atletaId  String
  atleta    Atleta   @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  fecha     DateTime
  createdAt DateTime @default(now())

  @@unique([atletaId, fecha])
}

model Lesion {
  id            String    @id @default(cuid())
  atletaId      String
  atleta        Atleta    @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  fechaConsulta DateTime  // Ingresada en el formulario
  diagnostico   String    // Ingresado en el formulario
  tratamiento   String    // Descripción a seguir
  estatus       String    @default("Activo") // Valores controlados: "Activo" o "Alta"
  fechaAlta     DateTime? // Registrada automáticamente por el sistema
  createdAt     DateTime  @default(now())
}

model Evento {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime
  color       String   // Código hexadecimal, ej. "#ef4444"
  grupo       String   @default("GENERAL") // Ej. "TORNEOS", "PREPARACIÓN O ENTRENAMIENTOS"
  createdAt   DateTime @default(now())
}

model SesionGimnasio {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime
  color       String
  createdAt   DateTime @default(now())
}

model VideoGimnasio {
  id           String   @id @default(cuid())
  titulo       String
  descripcion  String?
  url          String
  categoria    String
  subcategoria String?
  createdAt    DateTime @default(now())
}

model CatalogoEjercicio {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())
}

model EtapaEntrenamiento {
  id          String               @id @default(cuid())
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  ejercicios  EjercicioPrincipal[]
  createdAt   DateTime             @default(now())
}

model EjercicioPrincipal {
  id          String               @id @default(cuid())
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  etapaId     String?
  etapa       EtapaEntrenamiento?  @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  semanas     DetalleSemana[]
  createdAt   DateTime             @default(now())
}

model DetalleSemana {
  id                String              @id @default(cuid())
  ejercicioId       String
  ejercicio         EjercicioPrincipal  @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  numeroSemana      Int
  fechaInicioSemana DateTime
  fechaFinSemana    DateTime
  series            Int
  rpt               String
  rir               Int?
  createdAt         DateTime            @default(now())
}

model EjercicioAccesorio {
  id        String   @id @default(cuid())
  nombre    String
  tipo      String
  createdAt DateTime @default(now())
}

model NotaProgramacion {
  id        String   @id @default(cuid())
  contenido String
  orden     Int // mantiene el orden de despliegue — ver app/actions/notas-programacion.actions.ts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CitaMedica {
  id               String   @id @default(cuid())
  atletaId         String
  atleta           Atleta   @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  tipoEspecialista String   // "Psicólogo" | "Nutriólogo" | "Dentista" | "Médico General" | "Otro"
  fechaHora        DateTime
  motivo           String
  estado           String   @default("Programada") // "Programada" | "Completada" | "Cancelada"
  createdAt        DateTime @default(now())
}

model Logro {
  id          String        @id @default(cuid())
  titulo      String
  descripcion String
  anio        Int
  rama        String // 'Femenil' | 'Varonil' | 'Ambas'
  categoria   String // '1er Lugar' | '2do Lugar' | '3er Lugar' | 'Campeon' | 'Participacion'
  imagenes    LogroImagen[]
  createdAt   DateTime      @default(now())
}

model LogroImagen {
  id      String @id @default(cuid())
  logroId String
  logro   Logro  @relation(fields: [logroId], references: [id], onDelete: Cascade)
  url     String
  orden   Int
}
