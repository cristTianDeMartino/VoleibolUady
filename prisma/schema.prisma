generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Atleta {
  id               String   @id @default(cuid())
  nombre           String
  apellidos        String
  genero           String   @default("F")   // "M" = Masculino, "F" = Femenino
  rama             String   @default("Femenil") // "Femenil" | "Varonil"
  posicion         String
  facultad         String
  directorFacultad String
  semestre         Int
  telefonoPersonal String
  telefonoTutor    String
  nss              String
  seguroPrivado    String?
  codigoAcceso     String   @unique
  rol              String   @default("JUGADOR")
  fotoUrl          String?
  lesiones         Lesion[]
  asistencias      Asistencia[]
  createdAt        DateTime @default(now())
}

model Partido {
  id             String   @id @default(cuid())
  rama           String   // "Varonil" o "Femenil"
  torneo         String   // Nombre del torneo o liga
  fecha          DateTime // Fecha del partido
  hora           String   // Hora del partido (ej. "18:00")
  sede           String   // Lugar donde se jugó
  rival          String   // Nombre del equipo contrario
  numeroSets     Int      // Cantidad de sets jugados (ej. 3, 4, 5)
  resultadoSets  String   // Parciales del partido (ej. "25-23, 22-25, 15-11")
  resultadoFinal String   // "Ganado" o "Perdido"
  createdAt      DateTime @default(now())
}

model Asistencia {
  id        String   @id @default(cuid())
  atletaId  String
  atleta    Atleta   @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  fecha     DateTime
  createdAt DateTime @default(now())

  @@unique([atletaId, fecha])
}

model Lesion {
  id            String    @id @default(cuid())
  atletaId      String
  atleta        Atleta    @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  fechaConsulta DateTime  // Ingresada en el formulario
  diagnostico   String    // Ingresado en el formulario
  tratamiento   String    // Descripción a seguir
  estatus       String    @default("Activo") // Valores controlados: "Activo" o "Alta"
  fechaAlta     DateTime? // Registrada automáticamente por el sistema
  createdAt     DateTime  @default(now())
}

model Evento {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime
  color       String   // Código hexadecimal, ej. "#ef4444"
  grupo       String   @default("GENERAL") // Ej. "TORNEOS", "PREPARACIÓN O ENTRENAMIENTOS"
  createdAt   DateTime @default(now())
}

model SesionGimnasio {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime
  color       String
  createdAt   DateTime @default(now())
}

model VideoGimnasio {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  url         String
  categoria   String
  createdAt   DateTime @default(now())
}
